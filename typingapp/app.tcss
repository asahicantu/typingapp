Screen {
    background: #0d0d0d;
}

.stat-label {
    color: #888888;
}

.stat-value {
    color: #ffffff;
    text-style: bold;
}

.wpm-value { color: #f9c74f; }
.acc-value { color: #90be6d; }
.time-value { color: #43b0f1; }
.err-value { color: #c77dff; }

.hint-bar {
    background: #1a1a2e;
    border: tall #2a2a4e;
    color: #43b0f1;
    padding: 0 1;
}

.correct { color: #90be6d; }
.error   { background: #ff6b6b; color: #ffffff; }
.pending { color: #555555; }

.menu-title {
    color: #f9c74f;
    text-style: bold;
}

.section-title {
    color: #43b0f1;
    text-style: bold;
    margin: 1 0 0 0;
}

.section-desc {
    color: #888888;
    text-style: italic;
    margin: 0 0 1 0;
}

#results-cards {
    height: auto;
    max-height: 20;
}

.result-card {
    width: 1fr;
    height: 20;
    border: round #333333;
    padding: 1 2;
    margin: 0 1 0 0;
}

.result-card:focus {
    border: round #43b0f1;
}

#menu-box {
    width: 40;
    padding: 2 4;
    border: tall #333333;
}

#menu-box Button {
    width: 100%;
    margin: 0 0 1 0;
}

.nav-hint {
    color: #666666;
    text-style: italic;
    text-align: center;
    width: 100%;
}

#results-commands {
    height: auto;
    align: center middle;
    width: 100%;
}

.command-item {
    color: #43b0f1;
    text-style: bold;
    width: auto;
    margin: 0 2 0 2;
}

.setting-row {
    height: auto;
    margin: 0 0 1 0;
    align: left middle;
    width: 100%;
}

.setting-row Label {
    width: 2fr;
}

.setting-row Switch,
.setting-row Select {
    width: 1fr;
}

#stats-bar {
    height: 1;
    margin: 0 0 1 0;
}

#text-scroll {
    border: tall #333333;
    padding: 1 2;
    margin: 1 0;
    height: 1fr;
    max-height: 60%;
}

#text-display {
    height: auto;
}
